{
  "network": {
    "description": "网络",
    "type": "object",
    "items": {
      "proxy": {
        "description": "出站代理",
        "type": "string",
        "default": "",
        "hint": "访问 OP.GG / Data Dragon / CommunityDragon 时使用，例如 http://127.0.0.1:7890；留空直连"
      },
      "ddragon_base": {
        "description": "Data Dragon 地址",
        "type": "string",
        "default": "https://ddragon.leagueoflegends.com",
        "hint": "可换成镜像地址",
        "invisible": true
      },
      "cdragon_base": {
        "description": "CommunityDragon 地址",
        "type": "string",
        "default": "https://raw.communitydragon.org",
        "invisible": true
      },
      "gamedata_refresh_hours": {
        "description": "游戏静态数据刷新间隔（小时）",
        "type": "int",
        "default": 24,
        "invisible": true
      }
    }
  },
  "output": {
    "description": "输出",
    "type": "object",
    "items": {
      "default_mode": {
        "description": "默认输出方式",
        "type": "string",
        "default": "image",
        "options": [
          "image",
          "markdown",
          "text"
        ],
        "labels": [
          "图片整合",
          "Markdown",
          "纯文本"
        ],
        "hint": "可被会话设置（/lol 模式）和单次参数（-t/-m/-i）覆盖"
      },
      "markdown_platforms": {
        "description": "支持 Markdown 的平台",
        "type": "list",
        "default": [
          "telegram",
          "discord",
          "lark",
          "kook",
          "dingtalk",
          "slack",
          "mattermost",
          "webchat"
        ],
        "hint": "不在列表中的平台会把 Markdown 降级为纯文本。QQ 官方机器人开通 Markdown 权限后可加入 qq_official"
      },
      "text_max_rows": {
        "description": "文本 / Markdown 每个表格最多行数",
        "type": "int",
        "default": 10,
        "invisible": true
      },
      "image_max_rows": {
        "description": "图片每个表格最多行数",
        "type": "int",
        "default": 15,
        "invisible": true
      },
      "image_renderer": {
        "description": "图片渲染方式",
        "type": "string",
        "default": "auto",
        "options": [
          "auto",
          "t2i",
          "playwright"
        ],
        "labels": [
          "自动",
          "AstrBot 文转图服务",
          "本地 Playwright"
        ],
        "hint": "自动：已安装 playwright 时用本地浏览器渲染（找不到 Chromium 会改用系统 Edge/Chrome），否则用 AstrBot 文转图服务。本地渲染通常 3~5 秒，公共 t2i 服务 4~20 秒",
        "invisible": true
      },
      "image_theme": {
        "description": "图片主题",
        "type": "string",
        "default": "fog",
        "options": [
          "dark",
          "graphite",
          "fog",
          "silver",
          "warm",
          "light"
        ],
        "labels": [
          "炭黑",
          "石墨灰",
          "雾灰（推荐）",
          "银灰",
          "暖灰",
          "浅色"
        ]
      },
      "show_tips": {
        "description": "显示指令引导",
        "type": "bool",
        "default": true,
        "hint": "在卡片底部显示 2~3 条相关指令示例，例如在梯队卡上提示 /lol 英雄 3 查看第 3 名的出装"
      },
      "image_quality": {
        "description": "图片 JPEG 质量",
        "type": "int",
        "default": 85,
        "slider": {
          "min": 30,
          "max": 100,
          "step": 5
        },
        "invisible": true
      },
      "image_fallback_markdown": {
        "description": "图片失败时用 Markdown 转图",
        "type": "bool",
        "default": true,
        "hint": "HTML 渲染不可用时，用 AstrBot 自带的本地 Markdown 渲染出图；关闭则直接发纯文本",
        "invisible": true
      },
      "inline_icons": {
        "description": "图片内嵌图标",
        "type": "bool",
        "default": true,
        "hint": "由插件下载英雄/装备图标并内嵌到图片模板，避免 t2i 服务访问图床超时导致图标缺失",
        "invisible": true
      }
    }
  },
  "query": {
    "description": "查询",
    "type": "object",
    "items": {
      "default_region": {
        "description": "外服默认大区",
        "type": "string",
        "default": "kr",
        "options": [
          "kr",
          "na",
          "euw",
          "eune",
          "jp",
          "br",
          "lan",
          "las",
          "oce",
          "ru",
          "tr",
          "sg",
          "ph",
          "tw",
          "vn",
          "th",
          "me"
        ]
      },
      "match_count": {
        "description": "战绩默认场次",
        "type": "int",
        "default": 8,
        "slider": {
          "min": 1,
          "max": 20,
          "step": 1
        }
      },
      "match_details": {
        "description": "战绩列表显示完整对局",
        "type": "bool",
        "default": true,
        "hint": "外服战绩会逐场请求单局详情，用于显示双方 10 人、参团率、伤害占比和战绩标签（结果缓存 24 小时）；关闭可减少请求",
        "invisible": true
      },
      "timezone": {
        "description": "时区",
        "type": "string",
        "default": "Asia/Shanghai",
        "invisible": true
      }
    }
  },
  "meta": {
    "description": "英雄数据",
    "type": "object",
    "hint": "梯队排行榜和英雄出装使用的 OP.GG 数据范围；查询时也可临时指定，例如 /lol 梯队 中单 韩服 钻石+",
    "items": {
      "region": {
        "description": "数据地区",
        "type": "string",
        "default": "global",
        "options": [
          "global",
          "kr"
        ],
        "labels": [
          "全球",
          "韩服"
        ]
      },
      "tier": {
        "description": "段位范围",
        "type": "string",
        "default": "emerald_plus",
        "options": [
          "all",
          "gold_plus",
          "platinum_plus",
          "emerald_plus",
          "diamond_plus",
          "master_plus",
          "master",
          "grandmaster",
          "challenger"
        ],
        "labels": [
          "全部段位",
          "黄金及以上",
          "铂金及以上",
          "翡翠及以上",
          "钻石及以上",
          "大师及以上",
          "超凡大师",
          "傲世宗师",
          "最强王者"
        ],
        "hint": "大乱斗、无限火力没有段位划分，固定使用全部段位"
      }
    }
  },
  "cn": {
    "description": "国服",
    "type": "object",
    "hint": "默认关闭。开启后：AstrBot 与国服客户端在同一台 Windows 电脑上时无需其他设置；否则填写「远程国服代理」或「WeGame 凭证」任意一项",
    "items": {
      "enabled": {
        "description": "启用国服战绩查询（默认关闭）",
        "type": "bool",
        "default": false,
        "hint": "风险提示：本功能通过英雄联盟客户端本地接口（LCU API）或 WeGame 网页接口读取战绩数据，二者均非腾讯官方开放的数据服务。国服对第三方工具的管理政策可能调整，使用本功能存在账号被限制或处罚的风险，由使用者自行承担。如对账号安全有顾虑，请保持关闭。"
      },
      "default_server": {
        "description": "绑定国服时的默认大区",
        "type": "string",
        "default": "",
        "options": [
          "",
          "TENCENT_HN1",
          "TENCENT_HN10",
          "TENCENT_NJ100",
          "TENCENT_GZ100",
          "TENCENT_CQ100",
          "TENCENT_TJ100",
          "TENCENT_TJ101",
          "TENCENT_BGP2"
        ],
        "labels": [
          "跟随客户端当前大区",
          "艾欧尼亚",
          "黑色玫瑰",
          "联盟一区",
          "联盟二区",
          "联盟三区",
          "联盟四区",
          "联盟五区",
          "峡谷之巅"
        ]
      },
      "bridge_url": {
        "description": "远程国服代理（可选）",
        "type": "string",
        "default": "",
        "hint": "留空 = 直接连接本机国服客户端。AstrBot 在服务器 / Docker 上时，填代理窗口显示的完整地址，例如 http://192.168.1.5:6198?token=xxxx"
      },
      "wegame_cookie": {
        "description": "WeGame 凭证（可选）",
        "type": "string",
        "default": "",
        "secret": true,
        "hint": "客户端连不上时改用 WeGame 查国服。浏览器登录 wegame.com.cn 后，在开发者工具 → Application → Cookies 复制 tgp_id 和 tgp_ticket，按 tgp_id=…; tgp_ticket=… 填写（也可粘贴整串 Cookie）。凭证会过期，过期后重新复制；建议用小号"
      },
      "bridge_token": {
        "description": "远程国服代理 Token（旧版）",
        "type": "string",
        "default": "",
        "secret": true,
        "hint": "新版直接写在远程地址的 ?token= 里，这里仅兼容旧配置",
        "invisible": true
      },
      "timeout": {
        "description": "代理请求超时（秒）",
        "type": "int",
        "default": 15,
        "invisible": true
      },
      "servers_extra": {
        "description": "额外大区名称",
        "type": "text",
        "default": "",
        "hint": "League Akari 新增大区时使用，每行 TENCENT_XXX=名称；对应的 SGP 地址填在 bridge.json 的 sgp_servers",
        "invisible": true
      }
    }
  },
  "esports": {
    "description": "赛事",
    "type": "object",
    "items": {
      "default_leagues": {
        "description": "赛程默认赛事",
        "type": "list",
        "default": [],
        "hint": "没有订阅赛事的会话发送 /lol 赛程、赛果、赛况时默认只看这些，例如 S赛、LPL、LCK；留空显示全部。已订阅的会话按订阅的赛事显示"
      }
    }
  },
  "push": {
    "description": "主动推送",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用推送",
        "type": "bool",
        "default": true
      },
      "match_interval_min": {
        "description": "新对局检查间隔（分钟）",
        "type": "int",
        "default": 5
      },
      "esports_remind_min": {
        "description": "开赛前多少分钟提醒",
        "type": "int",
        "default": 30
      },
      "esports_game_data": {
        "description": "赛果推送附带每局数据",
        "type": "bool",
        "default": true,
        "hint": "开启时等 OP.GG 发布每局阵容和数据后再推送（最多等 40 分钟）；关闭则比赛结束立即只推比分"
      },
      "daily_hour": {
        "description": "日报推送时刻（0-23 点）",
        "type": "int",
        "default": 10
      },
      "group_admin_only": {
        "description": "群聊仅管理员可订阅",
        "type": "bool",
        "default": false
      },
      "max_new_matches": {
        "description": "单次最多推送新对局数",
        "type": "int",
        "default": 3,
        "invisible": true
      },
      "esports_interval_min": {
        "description": "赛程检查间隔（分钟）",
        "type": "int",
        "default": 5,
        "invisible": true,
        "hint": "平时的检查间隔；比赛进行中或即将开赛时自动改为每分钟检查"
      }
    }
  },
  "aliases": {
    "description": "别名",
    "type": "object",
    "items": {
      "champion_aliases": {
        "description": "英雄自定义别名",
        "type": "text",
        "default": "",
        "hint": "每行 别名=英文ID，例如 托儿索=Yasuo、小鱼=Fizz。英文 ID 见 Data Dragon"
      }
    }
  },
  "data_source": {
    "description": "数据源",
    "type": "object",
    "items": {
      "mcp_endpoint": {
        "description": "OP.GG MCP 地址",
        "type": "string",
        "default": "https://mcp-api.op.gg/mcp",
        "hint": "OP.GG 官方 MCP（Streamable HTTP），一般无需修改",
        "invisible": true
      },
      "timeout": {
        "description": "请求超时（秒）",
        "type": "int",
        "default": 20,
        "invisible": true
      },
      "concurrency": {
        "description": "最大并发请求数",
        "type": "int",
        "default": 4,
        "slider": {
          "min": 1,
          "max": 16,
          "step": 1
        },
        "invisible": true
      },
      "min_interval_ms": {
        "description": "两次请求最小间隔（毫秒）",
        "type": "int",
        "default": 150,
        "invisible": true
      },
      "tool_overrides": {
        "description": "MCP 工具名映射",
        "type": "text",
        "default": "",
        "hint": "OP.GG 改名时使用，每行 旧名=新名，例如 lol_list_summoner_matches=lol_get_summoner_matches",
        "invisible": true
      }
    },
    "invisible": true
  },
  "cache": {
    "description": "缓存",
    "type": "object",
    "items": {
      "meta_ttl_min": {
        "description": "梯队数据（分钟）",
        "type": "int",
        "default": 180,
        "invisible": true
      },
      "build_ttl_min": {
        "description": "英雄出装（分钟）",
        "type": "int",
        "default": 60,
        "invisible": true
      },
      "tft_ttl_min": {
        "description": "云顶数据（分钟）",
        "type": "int",
        "default": 60,
        "invisible": true
      },
      "profile_ttl_sec": {
        "description": "召唤师资料（秒）",
        "type": "int",
        "default": 300,
        "invisible": true
      },
      "matches_ttl_sec": {
        "description": "战绩（秒）",
        "type": "int",
        "default": 120,
        "invisible": true
      },
      "esports_ttl_sec": {
        "description": "电竞赛程（秒）",
        "type": "int",
        "default": 300,
        "invisible": true
      }
    },
    "invisible": true
  }
}
